<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Waylonia</RootNamespace>
    <AssemblyName>Waylonia</AssemblyName>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>dev.drasticactions.waylonia</ApplicationId>
    <ApplicationTitle>Waylonia</ApplicationTitle>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Waylonia.UI/Waylonia.UI.csproj" />
    <ProjectReference Include="../Waylonia.Ssh.Tmds/Waylonia.Ssh.Tmds.csproj" />
    <PackageReference Include="Avalonia.Android" />
    <ProjectReference Include="../../external/basin/src/Basin.Video.MediaCodec/Basin.Video.MediaCodec.csproj" />
  </ItemGroup>

</Project>
