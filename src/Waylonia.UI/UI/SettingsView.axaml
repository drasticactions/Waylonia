<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:union="https://github.com/avaunion"
             xmlns:ui="clr-namespace:Waylonia.UI"
             x:Class="Waylonia.UI.SettingsView"
             x:DataType="ui:SettingsViewModel"
             Background="{DynamicResource Union.Active.Window.Background.NormalBrush}"
             Foreground="{DynamicResource Union.Active.Window.Foreground.TextBrush}">
  <UserControl.Styles>
    <Style Selector="ScrollViewer.page > StackPanel">
      <Setter Property="Margin" Value="6,0,18,18" />
    </Style>
  </UserControl.Styles>
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource Union.Active.Window.Decoration.FrameBrush}">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="12" HorizontalAlignment="Right">
        <Button x:Name="RevertButton" Command="{Binding ReloadCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <union:UnionIcon IconName="document-revert" Width="16" Height="16" />
            <TextBlock Text="Revert" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="SaveButton" Command="{Binding SaveSettingsCommand}" IsDefault="True">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <union:UnionIcon IconName="document-save" Width="16" Height="16" />
            <TextBlock Text="Save" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
    <Grid ColumnDefinitions="200,*">
      <ListBox x:Name="Pages" Grid.Column="0" Margin="12,12,6,12" SelectedIndex="0">
        <ListBoxItem>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <union:UnionIcon IconName="computer" Width="22" Height="22" />
            <TextBlock Text="Host" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <union:UnionIcon IconName="preferences-system-network" Width="22" Height="22" />
            <TextBlock Text="Defaults" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <union:UnionIcon IconName="preferences-desktop-keyboard-shortcut" Width="22" Height="22" />
            <TextBlock Text="Hotkeys" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <union:UnionIcon IconName="preferences-desktop-display" Width="22" Height="22" />
            <TextBlock Text="Desktops" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <union:UnionIcon IconName="preferences-system-windows" Width="22" Height="22" />
            <TextBlock Text="Shell" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <union:UnionIcon IconName="input-mouse" Width="22" Height="22" />
            <TextBlock Text="Mouse and keys" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <union:UnionIcon IconName="preferences-desktop" Width="22" Height="22" />
            <TextBlock Text="Panel" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
      </ListBox>
      <DockPanel Grid.Column="1" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="6,12,18,10" Spacing="8">
          <NotificationCard x:Name="ProblemCard" Classes="inline" NotificationType="Error"
                            IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}">
            <SelectableTextBlock Text="{Binding Problem}" />
          </NotificationCard>
          <NotificationCard x:Name="NoteCard" Classes="inline" NotificationType="Warning"
                            IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}">
            <SelectableTextBlock Text="{Binding Note}" />
          </NotificationCard>
        </StackPanel>
        <Carousel x:Name="PageHost" SelectedIndex="{Binding #Pages.SelectedIndex}">

          <ScrollViewer Classes="page">
            <StackPanel Classes="form" DataContext="{Binding Form}" x:DataType="ui:SettingsFormViewModel">
              <union:Heading Classes="page" Content="Host" />
              <ui:FormField Hint="Lets X11 apps run, on this computer and in each session.">
                <ToggleSwitch Content="Start XWayland" IsChecked="{Binding XWayland}" ToolTip.Tip="[host] xwayland" />
              </ui:FormField>
              <ui:FormField Hint="Shows Waylonia's icon and menu in the system tray.">
                <ToggleSwitch Content="Tray icon" IsChecked="{Binding Tray}" ToolTip.Tip="[host] tray" />
              </ui:FormField>
              <ui:FormField Hint="Lists each session's apps in the tray menu, by category. Needs the tray icon.">
                <ToggleSwitch Content="Apps in the tray menu" IsChecked="{Binding TrayApps}" ToolTip.Tip="[host] tray-apps" />
              </ui:FormField>
              <ui:FormField Hint="Lets you copy and paste between your desktop and the apps.">
                <ToggleSwitch Content="Share the clipboard" IsChecked="{Binding Clipboard}" ToolTip.Tip="[host] clipboard" />
              </ui:FormField>
              <ui:FormField Hint="Lets you drag things between your desktop and the apps.">
                <ToggleSwitch Content="Drag and drop" IsChecked="{Binding Drag}" ToolTip.Tip="[host] drag" />
              </ui:FormField>
              <ui:FormField Hint="Opens each new window on the screen the pointer is on.">
                <ToggleSwitch Content="Open windows where the pointer is" IsChecked="{Binding FollowCursor}" ToolTip.Tip="[host] follow-cursor" />
              </ui:FormField>
              <ui:FormField Hint="Keeps a session's own display scaling from sizing GTK windows twice.">
                <ToggleSwitch Content="Fix GTK scaling" IsChecked="{Binding GtkDpi}" ToolTip.Tip="[host] gtk-dpi" />
              </ui:FormField>
              <ui:FormField Hint="Ends each window title with the name of its session.">
                <ToggleSwitch Content="Session name in titles" IsChecked="{Binding SessionTitles}" ToolTip.Tip="[host] session-titles" />
              </ui:FormField>
              <ui:FormField Hint="Lets apps type and click into each other, which some apps may require.">
                <ToggleSwitch Content="Virtual keyboard and pointer" IsChecked="{Binding VirtualInput}" ToolTip.Tip="[host] virtual-input" />
              </ui:FormField>
              <ui:FormField Label="Capture key" Problem="{Binding CaptureChordProblem}" ToolTip.Tip="[host] capture-chord"
                            Hint="Captures the mouse and keyboard input for a session or shell.">
                <TextBox x:Name="CaptureChordBox" Text="{Binding CaptureChord}" PlaceholderText="double:RightControl" />
              </ui:FormField>
              <ui:FormField Label="SSH timeout" Problem="{Binding SshTimeoutProblem}" ToolTip.Tip="[host] ssh-timeout"
                            Hint="How many seconds a session waits for its SSH server to answer.">
                <TextBox x:Name="SshTimeoutBox" Text="{Binding SshTimeout}" PlaceholderText="30" />
              </ui:FormField>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer Classes="page">
            <StackPanel Classes="form" DataContext="{Binding Form}" x:DataType="ui:SettingsFormViewModel">
              <union:Heading Classes="page" Content="Defaults" />
              <ui:FormField Label="Compression" ToolTip.Tip="compress">
                <ComboBox ItemsSource="{Binding CompressChoices}" SelectedIndex="{Binding CompressIndex}" HorizontalAlignment="Left" />
              </ui:FormField>
              <ui:FormField>
                <StackPanel Classes="options">
                  <CheckBox Content="Use the GPU" IsThreeState="True" IsChecked="{Binding Gpu}" ToolTip.Tip="gpu" />
                  <CheckBox Content="Play sound here" IsThreeState="True" IsChecked="{Binding Audio}" ToolTip.Tip="audio" />
                </StackPanel>
              </ui:FormField>
              <ui:FormField Label="Video encoding" Problem="{Binding VideoProblem}" ToolTip.Tip="video"
                            Hint="Accepts waypipe's video encoding syntax.">
                <TextBox Text="{Binding Video}" PlaceholderText="h264,hw" />
              </ui:FormField>
              <ui:FormField Label="Language" Problem="{Binding LangProblem}" ToolTip.Tip="lang"
                            Hint="The LANG a session gets when its login sets none. Write &quot;&quot; to use the system default.">
                <TextBox Text="{Binding Lang}" PlaceholderText="C.UTF-8" />
              </ui:FormField>
              <ui:FormField Label="Terminal" ToolTip.Tip="terminal"
                            Hint="Terminal application to use for running commands.">
                <TextBox Text="{Binding Terminal}" PlaceholderText="foot -e" />
              </ui:FormField>
              <ui:FormField Label="Show apps for" ToolTip.Tip="current-desktop"
                            Hint="Lists the apps meant for this desktop, by its XDG_CURRENT_DESKTOP name.">
                <TextBox Text="{Binding CurrentDesktop}" PlaceholderText="GNOME" />
              </ui:FormField>
              <ui:FormField Label="Wayland socket" Problem="{Binding SocketProblem}" ToolTip.Tip="socket"
                            Hint="The default Wayland socket name.">
                <TextBox Text="{Binding Socket}" PlaceholderText="wayland-9" />
              </ui:FormField>
              <ui:FormField Label="Startup app" ToolTip.Tip="command"
                            Hint="On Linux, the app Waylonia starts when you run it with no options.">
                <TextBox Text="{Binding Command}" PlaceholderText="foot" />
              </ui:FormField>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer Classes="page">
            <StackPanel Classes="form" DataContext="{Binding Form}" x:DataType="ui:SettingsFormViewModel">
              <union:Heading Classes="page" Content="Hotkeys" />
              <TextBlock Classes="hint" Text="Hotkeys for this computer. Set one per line as CHORD = COMMAND." />
              <TextBox x:Name="HotkeysBox" Classes="lines" MinHeight="200" Text="{Binding Hotkeys}" PlaceholderText="ctrl+alt+t = foot" ToolTip.Tip="[hotkeys]" />
              <TextBlock Classes="problem" Text="{Binding HotkeysProblem}"
                         IsVisible="{Binding HotkeysProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </ScrollViewer>

          <DockPanel Margin="6,0,18,18">
            <union:Heading DockPanel.Dock="Top" Classes="page" Content="Desktops" />
            <Grid ColumnDefinitions="180,*" Margin="0,6,0,0">
              <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                  <Button x:Name="NewDesktopButton" Command="{Binding NewDesktopCommand}" ToolTip.Tip="New desktop">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <union:UnionIcon IconName="list-add" Width="16" Height="16" />
                      <TextBlock Text="New" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="DeleteDesktopButton" Command="{Binding DeleteDesktopCommand}" ToolTip.Tip="Delete desktop">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <union:UnionIcon IconName="list-remove" Width="16" Height="16" />
                      <TextBlock Text="Delete" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <ListBox x:Name="DesktopList" ItemsSource="{Binding Desktops}" SelectedItem="{Binding SelectedDesktop}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="ui:DesktopFormViewModel">
                      <TextBlock Text="{Binding Label}" Margin="2" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
              <ScrollViewer Grid.Column="1" Margin="12,0,0,0"
                            IsVisible="{Binding SelectedDesktop, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Classes="form" DataContext="{Binding SelectedDesktop}" x:DataType="ui:DesktopFormViewModel">
                  <ui:FormField Label="Name" Problem="{Binding NameProblem}" ToolTip.Tip="[desktops.NAME]">
                    <TextBox x:Name="DesktopNameBox" Text="{Binding Name}" PlaceholderText="plasma" />
                  </ui:FormField>
                  <ui:FormField Label="Recipe" Problem="{Binding RecipeProblem}" ToolTip.Tip="recipe">
                    <ComboBox ItemsSource="{Binding RecipeChoices}" SelectedIndex="{Binding RecipeIndex}" HorizontalAlignment="Left" />
                  </ui:FormField>
                  <ui:FormField Label="Session" ToolTip.Tip="host"
                                Hint="The session or an SSH destination to run it in.">
                    <TextBox Text="{Binding Host}" PlaceholderText="devbox" />
                  </ui:FormField>
                  <ui:FormField Label="Size" Problem="{Binding SizeProblem}" ToolTip.Tip="size">
                    <TextBox Text="{Binding Size}" PlaceholderText="1920x1080" />
                  </ui:FormField>
                  <ui:FormField Label="Command" Problem="{Binding CommandProblem}" ToolTip.Tip="command">
                    <TextBox Text="{Binding Command}" PlaceholderText="startplasma-wayland" />
                  </ui:FormField>
                  <ui:FormField Label="Environment" Classes="lines" ToolTip.Tip="env"
                                Hint="Variables for the desktop, as NAME=value, one per line.">
                    <TextBox Classes="lines" Text="{Binding Env}" PlaceholderText="QT_QPA_PLATFORM=wayland" />
                  </ui:FormField>
                  <ui:FormField>
                    <CheckBox Content="Use the GPU" IsThreeState="True" IsChecked="{Binding Gpu}" ToolTip.Tip="gpu" />
                  </ui:FormField>
                  <ui:FormField Label="Video encoding" Problem="{Binding VideoProblem}" ToolTip.Tip="video">
                    <TextBox Text="{Binding Video}" PlaceholderText="h264,hw" />
                  </ui:FormField>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </DockPanel>

          <ScrollViewer Classes="page">
            <StackPanel Classes="form" DataContext="{Binding Form}" x:DataType="ui:SettingsFormViewModel">
              <union:Heading Classes="page" Content="Shell" />
              <ui:FormField Label="Window mode" ToolTip.Tip="[host] shell"
                            Hint="Window mode sets allows each app to get its own window. Nested mode shares one window for all apps.">
                <ComboBox x:Name="ShellModeBox" ItemsSource="{Binding ShellModeChoices}" SelectedIndex="{Binding ShellModeIndex}" HorizontalAlignment="Left" />
              </ui:FormField>

              <union:Heading Classes="section" Content="Look" />
              <ui:FormField Label="Theme" Problem="{Binding ThemeProblem}" ToolTip.Tip="[shell] theme">
                <ComboBox x:Name="ThemeBox" IsEditable="True" Text="{Binding Theme}" ItemsSource="{Binding ThemeChoices}" PlaceholderText="Atlanta" HorizontalAlignment="Stretch" />
              </ui:FormField>
              <ui:FormField Label="Title bar buttons" Problem="{Binding ButtonLayoutProblem}" ToolTip.Tip="[shell] button-layout"
                            Hint="The layout of the title bar buttons.">
                <TextBox Text="{Binding ButtonLayout}" PlaceholderText="menu:minimize,maximize,close" />
              </ui:FormField>
              <ui:FormField Label="Theme colors" ToolTip.Tip="[shell] palette">
                <ComboBox ItemsSource="{Binding PaletteChoices}" SelectedIndex="{Binding PaletteIndex}" HorizontalAlignment="Left" />
              </ui:FormField>
              <ui:FormField Label="Title font size" Problem="{Binding FontSizeProblem}" ToolTip.Tip="[shell] font-size" Hint="In logical pixels.">
                <TextBox Text="{Binding FontSize}" PlaceholderText="13" />
              </ui:FormField>
              <ui:FormField Label="Desktop color" Problem="{Binding BackgroundProblem}" ToolTip.Tip="[shell] background"
                            Hint="The color behind the windows, as #rrggbb.">
                <TextBox Text="{Binding Background}" PlaceholderText="#5891ad" />
              </ui:FormField>

              <union:Heading Classes="section" Content="Workspaces" />
              <ui:FormField Label="Number" Problem="{Binding WorkspacesProblem}" ToolTip.Tip="[shell] workspaces">
                <TextBox Text="{Binding Workspaces}" PlaceholderText="4" />
              </ui:FormField>
              <ui:FormField Label="Rows" Problem="{Binding WorkspaceRowsProblem}" ToolTip.Tip="[shell] workspace-rows">
                <TextBox Text="{Binding WorkspaceRows}" PlaceholderText="1" />
              </ui:FormField>
              <ui:FormField Label="Names" ToolTip.Tip="[shell] workspace-names" Hint="Separate the names with commas. Workspaces past the list get numbers.">
                <TextBox Text="{Binding WorkspaceNames}" PlaceholderText="Main, Mail" />
              </ui:FormField>
              <union:Heading Classes="section" Content="Focus" />
              <ui:FormField Label="Focus mode" ToolTip.Tip="[shell] focus-mode">
                <ComboBox ItemsSource="{Binding FocusModeChoices}" SelectedIndex="{Binding FocusModeIndex}" HorizontalAlignment="Left" />
              </ui:FormField>
              <ui:FormField Label="New windows" ToolTip.Tip="[shell] focus-new-windows">
                <ComboBox ItemsSource="{Binding FocusNewWindowsChoices}" SelectedIndex="{Binding FocusNewWindowsIndex}" HorizontalAlignment="Left" />
              </ui:FormField>
              <ui:FormField Hint="Brings a window to the front when you click it.">
                <ToggleSwitch Content="Raise on click" IsChecked="{Binding RaiseOnClick}" ToolTip.Tip="[shell] raise-on-click" />
              </ui:FormField>
              <ui:FormField Hint="Brings the window under the pointer to the front after a delay, with sloppy or mouse focus.">
                <ToggleSwitch Content="Raise on hover" IsChecked="{Binding AutoRaise}" ToolTip.Tip="[shell] auto-raise" />
              </ui:FormField>
              <ui:FormField Label="Raise delay" Problem="{Binding AutoRaiseDelayProblem}" ToolTip.Tip="[shell] auto-raise-delay" Hint="In milliseconds.">
                <TextBox Text="{Binding AutoRaiseDelay}" PlaceholderText="500" />
              </ui:FormField>

              <union:Heading Classes="section" Content="Placement" />
              <ui:FormField Label="Place new windows" ToolTip.Tip="[shell] placement"
                            Hint="With automatic, a new window goes into free space. With pointer, it opens under the pointer. With manual, you move it into place.">
                <ComboBox ItemsSource="{Binding PlacementChoices}" SelectedIndex="{Binding PlacementIndex}" HorizontalAlignment="Left" />
              </ui:FormField>
              <ui:FormField Hint="Centers a window that fits nowhere, instead of cascading it.">
                <ToggleSwitch Content="Center new windows" IsChecked="{Binding CenterNewWindows}" ToolTip.Tip="[shell] center-new-windows" />
              </ui:FormField>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer Classes="page">
            <StackPanel Classes="form" DataContext="{Binding Form}" x:DataType="ui:SettingsFormViewModel">
              <union:Heading Classes="page" Content="Mouse and keys" />
              <ui:FormField Label="Modifier key" ToolTip.Tip="[shell] mouse-button-modifier"
                            Hint="Hold it and use a mouse button anywhere in a window to move, resize or lower it.">
                <ComboBox ItemsSource="{Binding MouseButtonModifierChoices}" SelectedIndex="{Binding MouseButtonModifierIndex}" HorizontalAlignment="Left" />
              </ui:FormField>
              <ui:FormField>
                <ToggleSwitch Content="Resize with the right button" IsChecked="{Binding ResizeWithRightButton}" ToolTip.Tip="[shell] resize-with-right-button" />
              </ui:FormField>

              <union:Heading Classes="section" Content="Title bar" />
              <ui:FormField Label="Double-click" ToolTip.Tip="[shell] double-click-titlebar">
                <ComboBox ItemsSource="{Binding TitlebarActionChoices}" SelectedIndex="{Binding DoubleClickTitlebarIndex}" HorizontalAlignment="Left" />
              </ui:FormField>
              <ui:FormField Label="Middle-click" ToolTip.Tip="[shell] middle-click-titlebar">
                <ComboBox ItemsSource="{Binding TitlebarActionChoices}" SelectedIndex="{Binding MiddleClickTitlebarIndex}" HorizontalAlignment="Left" />
              </ui:FormField>
              <ui:FormField Label="Right-click" ToolTip.Tip="[shell] right-click-titlebar">
                <ComboBox ItemsSource="{Binding TitlebarActionChoices}" SelectedIndex="{Binding RightClickTitlebarIndex}" HorizontalAlignment="Left" />
              </ui:FormField>

              <union:Heading Classes="section" Content="Tiling" />
              <ui:FormField Hint="Drag a window to the left or right edge to fill that half of the screen.">
                <ToggleSwitch Content="Tile at the side edges" IsChecked="{Binding Tiling}" ToolTip.Tip="[shell] tiling" />
              </ui:FormField>
              <ui:FormField Hint="Drag a window to the top edge to maximize it.">
                <ToggleSwitch Content="Maximize at the top edge" IsChecked="{Binding TopTiling}" ToolTip.Tip="[shell] top-tiling" />
              </ui:FormField>

              <union:Heading Classes="section" Content="Keys" />
              <TextBlock Classes="hint" Text="Shortcuts inside the nested shell, listed one per line as NAME = CHORD. Leave the chord empty to turn a shortcut off." />
              <TextBox x:Name="ShellKeysBox" Classes="lines" MinHeight="140" Text="{Binding ShellKeys}" PlaceholderText="switch-windows = Alt+Tab" ToolTip.Tip="[shell.keys]" />
              <TextBlock Classes="problem" Text="{Binding ShellKeysProblem}"
                         IsVisible="{Binding ShellKeysProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer Classes="page">
            <StackPanel Classes="form" DataContext="{Binding Form}" x:DataType="ui:SettingsFormViewModel">
              <union:Heading Classes="page" Content="Panel" />
              <ui:FormField Label="Size" Problem="{Binding PanelSizeProblem}" ToolTip.Tip="[panel] size" Hint="The height of each panel, in logical pixels.">
                <TextBox Text="{Binding PanelSize}" PlaceholderText="24" />
              </ui:FormField>
              <ui:FormField Label="Top panel" Problem="{Binding PanelTopProblem}" ToolTip.Tip="[panel] top"
                            Hint="Applets from left to right, separated by commas.">
                <TextBox Text="{Binding PanelTop}" PlaceholderText="menu-bar" />
              </ui:FormField>
              <ui:FormField Label="Bottom panel" Problem="{Binding PanelBottomProblem}" ToolTip.Tip="[panel] bottom"
                            Hint="Applets from left to right, separated by commas.">
                <TextBox Text="{Binding PanelBottom}" PlaceholderText="window-list, workspace-switcher" />
              </ui:FormField>
            </StackPanel>
          </ScrollViewer>

        </Carousel>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
