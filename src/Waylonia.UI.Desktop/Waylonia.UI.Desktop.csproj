  <ItemGroup>
    <ProjectReference Include="../Waylonia.UI/Waylonia.UI.csproj" />
    <PackageReference Include="Basin.Avalonia" />
    <PackageReference Include="BluerCurve" />
  </ItemGroup>

</Project>
