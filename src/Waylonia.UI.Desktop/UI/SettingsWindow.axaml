        x:Class="Waylonia.UI.SettingsWindow"
        x:DataType="ui:SettingsViewModel"
        Title="Waylonia settings"
        Width="760" Height="640" MinWidth="560" MinHeight="420"
        ShowInTaskbar="True">
  <ui:SettingsView />
</Window>
