<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Waylonia.Ui.AskPassView"
             Background="{DynamicResource BcBgBrush}"
             Foreground="{DynamicResource BcFgBrush}">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
    <TextBox x:Name="SecretBox" PasswordChar="•" PlaceholderText="Password" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="NoButton" Content="No" IsCancel="True" />
      <Button x:Name="YesButton" Content="Yes" IsDefault="True" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
      <Button x:Name="OkButton" Content="OK" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</UserControl>
