<chrome:BluerCurveWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Waylonia.Ui"
        xmlns:chrome="clr-namespace:BluerCurve.Chrome;assembly=BluerCurve.Theme"
        x:Class="Waylonia.Ui.ManagerWindow"
        x:DataType="ui:ManagerViewModel"
        Title="Waylonia Sessions"
        Width="760" Height="640" MinWidth="560" MinHeight="400"
        ShowInTaskbar="True">
  <ui:ManagerView />
</chrome:BluerCurveWindow>
